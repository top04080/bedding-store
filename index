<script>
/* ═══════════════════════════════════════
   ☁️  CLOUDINARY 設定
═══════════════════════════════════════ */
const CLOUD_NAME    = 'dkgdxdayy';
const UPLOAD_PRESET = 'bedding_unsigned';

/* ═══════════════════════════════════════
   📦  JSONBIN 設定
═══════════════════════════════════════ */
const JSONBIN_ID  = '69d70085856a68218912cc85';
const JSONBIN_KEY = '$2a$10$zKaUFojb2ZvEeE/SrDJBtODqvGXMQyLGT/bJC.xgUTecDnE1RXwKq';

/* 管理員密碼（SHA-256 雜湊，明文不儲存在程式碼中） */
const ADMIN_PASSWORD_HASH = 'b4895514b201dd0757818d74110eda1531bc2d3d50bb9ceae7d9409c6a08fd97';
async function hashPassword(pw){
  const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(pw));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}

/* 20 預設相簿 */
const DEFAULT_ALBUMS = [
  {id:'duvet-sets',   name:'被套組合',   desc:'精選四件組被套床包系列'},
  {id:'fitted-sheets',name:'床包系列',   desc:'各尺寸床包單售'},
  {id:'pillowcases',  name:'枕頭套',     desc:'素色與花色枕頭套'},
  {id:'comforters',   name:'棉被被芯',   desc:'四季適用棉被'},
  {id:'pillows',      name:'枕頭枕芯',   desc:'記憶棉、乳膠、羽絨枕頭'},
  {id:'winter',       name:'冬季系列',   desc:'厚實保暖冬季寢具'},
  {id:'summer',       name:'夏季系列',   desc:'輕薄涼感夏季寢具'},
  {id:'spring-fall',  name:'春秋系列',   desc:'適合過渡季節的中厚款'},
  {id:'solid-colors', name:'素色系列',   desc:'簡約素色設計'},
  {id:'printed',      name:'印花系列',   desc:'精美印花圖案'},
  {id:'embroidered',  name:'刺繡系列',   desc:'精緻刺繡工藝'},
  {id:'plaid',        name:'格紋系列',   desc:'經典格紋設計'},
  {id:'floral',       name:'花卉系列',   desc:'優雅花卉圖案'},
  {id:'geometric',    name:'幾何系列',   desc:'現代幾何圖形'},
  {id:'children',     name:'兒童系列',   desc:'可愛卡通主題'},
  {id:'hotel',        name:'飯店系列',   desc:'五星級飯店規格'},
  {id:'organic',      name:'有機棉系列', desc:'通過認證有機棉'},
  {id:'tencel',       name:'天絲系列',   desc:'TENCEL™天絲纖維'},
  {id:'flannel',      name:'法蘭絨系列', desc:'毛茸茸法蘭絨質地'},
  {id:'sale',         name:'特價專區',   desc:'精選特惠商品'},
];

/* ════════════ STATE ════════════ */
const LS_ALBUMS='hp_albums_v4';
const jbReady=JSONBIN_ID!=='YOUR_BIN_ID'&&JSONBIN_KEY!=='YOUR_MASTER_KEY';
const cloudReady=CLOUD_NAME!=='YOUR_CLOUD_NAME';
let isAdmin=false,allAlbums=[],currentAlbumId=null;
let currentImages=[],filteredImages=[],lbIndex=0;
let selectedIds=new Set(),currentSort='newest',currentPage=0;
const PAGE=40;

/* ════════════ INIT ════════════ */
function init(){
  const saved=localStorage.getItem(LS_ALBUMS);
  allAlbums=saved?JSON.parse(saved):DEFAULT_ALBUMS.map((a,i)=>({...a,coverUrl:'',imageCount:0,order:i,images:[]}));
  _hydrateUrls(allAlbums); // 從 publicId 補回 url 欄位
  renderAlbums(allAlbums);
  if(jbReady) loadFromCloud();
}

/* ════════════ JSONBIN ════════════ */
const JB_URL=`https://api.jsonbin.io/v3/b/${JSONBIN_ID}`;
const JB_HDR={'Content-Type':'application/json','X-Master-Key':JSONBIN_KEY,'X-Bin-Versioning':'false'};
const LS_UPDATED_AT='hp_updatedAt_v4';
async function jbGet(){const r=await fetch(JB_URL+'/latest',{headers:{'X-Master-Key':JSONBIN_KEY}});if(!r.ok)throw new Error(r.status);return(await r.json()).record;}
async function jbSet(d){const r=await fetch(JB_URL,{method:'PUT',headers:JB_HDR,body:JSON.stringify(d)});if(!r.ok)throw new Error(r.status);}

/* 計算一份 albums 陣列裡的「實際圖片總數」（images陣列長度之和，非 imageCount）*/
function _countRealImages(albums){return(albums||[]).reduce((s,a)=>s+(Array.isArray(a.images)?a.images.length:0),0);}

/* 偵測並修補 imageCount 與 images 陣列不一致的問題 */
function _fixImageCountDesync(albums){
  let fixed=false;
  (albums||[]).forEach(a=>{
    const real=Array.isArray(a.images)?a.images.length:0;
    if((a.imageCount||0)!==real){
      console.warn(`相簿「${a.name}」imageCount=${a.imageCount} 但 images.length=${real}，已自動修正`);
      a.imageCount=real;
      fixed=true;
    }
  });
  return fixed;
}

/* 從 publicId 重建 url 與 name（載入後補回，不存入 JSONBin 以節省空間）*/
function _hydrateUrls(albums){
  (albums||[]).forEach(a=>{
    (a.images||[]).forEach(img=>{
      if(!img.url&&img.publicId)
        img.url=`https://res.cloudinary.com/${CLOUD_NAME}/image/upload/${img.publicId}`;
      if(!img.name&&img.publicId)
        img.name=img.publicId.split('/').pop()||img.publicId;
    });
  });
}

/* 存入 JSONBin 前，移除可重建的大欄位（url、name），大幅縮減體積 */
function _slimForStorage(albums){
  return albums.map(a=>({
    ...a,
    images:(a.images||[]).map(({url:_u,name:_n,...rest})=>rest)
  }));
}

async function loadFromCloud(){
  try{
    const d=await jbGet();
    if(!d.albums||!d.albums.length){await saveToCloud();return;}

    const cloudTime = d.updatedAt||0;
    const localTime = parseInt(localStorage.getItem(LS_UPDATED_AT)||'0');
    const cloudImgs = _countRealImages(d.albums);
    const localImgs = _countRealImages(allAlbums);

    console.info(`[同步診斷] 雲端：${cloudImgs}張 t=${cloudTime} | 本機：${localImgs}張 t=${localTime}`);

    const useCloud = cloudTime>0||localTime>0
      ? cloudTime>=localTime
      : cloudImgs>=localImgs;

    if(useCloud){
      allAlbums=d.albums;
      _fixImageCountDesync(allAlbums);
      _hydrateUrls(allAlbums); // 補回 url 欄位
      localStorage.setItem(LS_ALBUMS,JSON.stringify(allAlbums));
      if(cloudTime>0) localStorage.setItem(LS_UPDATED_AT,String(cloudTime));
      renderAlbums(allAlbums);
      if(cloudImgs<localImgs)
        showToast(`⚠️ 雲端圖片(${cloudImgs}張)少於本機(${localImgs}張)，若有遺失請點「搶救資料」`,'error');
    } else {
      console.info(`本機資料較新（${localImgs}張 > 雲端${cloudImgs}張），同步上傳…`);
      showToast(`🔄 本機有較多資料(${localImgs}張 vs 雲端${cloudImgs}張)，同步中…`);
      await saveToCloud();
    }

    const desynced=allAlbums.filter(a=>(a.imageCount||0)>0&&(!Array.isArray(a.images)||a.images.length===0));
    if(desynced.length>0){
      console.error('發現資料不一致的相簿：',desynced.map(a=>a.name));
      showToast(`⚠️ 發現 ${desynced.length} 個相簿照片資料遺失（張數顯示但圖片空白），請點「搶救資料」`,'error');
    }
  }catch(e){console.warn('JSONBin load fail',e);}
}

async function saveToCloud(){
  _fixImageCountDesync(allAlbums);
  const now=Date.now();
  const slim=_slimForStorage(allAlbums);          // 移除 url/name，節省空間
  const payload={albums:slim,updatedAt:now};
  const json=JSON.stringify(payload);
  const sizeKB=Math.round(new Blob([json]).size/1024);
  console.info(`[saveToCloud] 資料量：${sizeKB}KB`);
  if(sizeKB>90) showToast(`⚠️ 資料量 ${sizeKB}KB 仍接近上限，請刪除部分圖片`,'error');
  // ✅ 先更新本機時間戳（無論雲端是否成功），確保下次載入時本機優先
  localStorage.setItem(LS_ALBUMS,JSON.stringify(allAlbums)); // 本機存完整版（含url）
  localStorage.setItem(LS_UPDATED_AT,String(now));
  if(jbReady)try{
    await jbSet(payload);
    showToast(`✅ 雲端同步成功（${sizeKB}KB）`,'success');
  }catch(e){
    console.error('JSONBin save fail',e);
    showToast(`⚠️ 雲端同步失敗（${sizeKB}KB），資料已保留在本機`,'error');
  }
}

/* ════════════ ALBUM HELPERS ════════════ */
function getImages(albumId){return(allAlbums.find(a=>a.id===albumId)?.images)||[];}
async function saveImages(albumId,imgs){
  const a=allAlbums.find(x=>x.id===albumId);
  if(a){a.images=imgs;a.imageCount=imgs.length;}
  await saveToCloud();
}

/* ════════════ RENDER ALBUMS ════════════ */
function renderAlbums(albums){
  const grid=document.getElementById('albums-grid');
  // 非管理員：隱藏空相簿
  const displayAlbums=isAdmin?albums:albums.filter(a=>(a.imageCount||0)>0);
  if(!displayAlbums.length){grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--text-muted)">尚無相簿</div>`;return;}
  grid.innerHTML=displayAlbums.map(a=>`
    <div class="album-card" data-id="${a.id}" onclick="openAlbum('${a.id}')">
      <div class="album-cover">
        ${a.coverUrl?`<img src="${v(a.coverUrl)}" alt="${v(a.name)}" loading="lazy">`
          :`<div class="album-cover-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span style="font-size:.7rem;font-weight:700;letter-spacing:.06em">尚無圖片</span></div>`}
        <div class="album-badge">${a.imageCount||0} 張</div>
        <div class="album-drag-handle" title="拖曳調整順序">⠿</div>
      </div>
      <div class="album-info">
        <div class="album-name">${v(a.name)}</div>
        <div class="album-desc">${v(a.desc||'')}</div>
      </div>
    </div>`).join('');
  // Album reorder drag (admin)
  if(isAdmin) initAlbumReorder();
  // 更新快速導覽按鈕（最後 2 個有圖片的相簿）
  renderQuickNav(albums);
}

/* ════════════ LOGO DOUBLE-CLICK → 管理後台 ════════════ */
let _logoClickCount=0,_logoClickTimer=null;
function handleLogoClick(){
  _logoClickCount++;
  if(_logoClickCount===1){
    _logoClickTimer=setTimeout(()=>{
      _logoClickCount=0;
      goHome();
    },350);
  } else if(_logoClickCount>=2){
    clearTimeout(_logoClickTimer);
    _logoClickCount=0;
    toggleAdmin();
  }
}
function renderQuickNav(albums){
  const nav=document.getElementById('quick-nav');
  if(!nav||!albums.length) return;
  // 後兩個捷徑固定取全部相簿的最後 2 個，不受空相簿隱藏影響
  const last2=albums.slice(-2);
