/* ════════════ BATCH DELETE ════════════ */
async function batchDelete(){
  if(!selectedIds.size)return;
  if(!confirm(`確定要刪除選取的 ${selectedIds.size} 張圖片嗎？`))return;
  const ids=[...selectedIds];
  let imgs=getImages(currentAlbumId).filter(i=>!ids.includes(i.id));
  await saveImages(currentAlbumId,imgs);
  currentImages=currentImages.filter(i=>!ids.includes(i.id));
  selectedIds.clear();
  applyImgSearch();
  updateSelection();
  renderAlbums(allAlbums);
  updatePanelInfo(allAlbums.find(a=>a.id===currentAlbumId));
  showToast(`✅ 已刪除 ${ids.length} 張`,'success');
}

/* ════════════ DELETE SINGLE ════════════ */
