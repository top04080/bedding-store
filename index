  ev.stopPropagation();
  if(!confirm('確定要刪除這張圖片嗎？'))return;
  let imgs=getImages(currentAlbumId).filter(i=>i.id!==imgId);
  await saveImages(currentAlbumId,imgs);
  currentImages=currentImages.filter(i=>i.id!==imgId);
  applyImgSearch();
  renderAlbums(allAlbums);
  updatePanelInfo(allAlbums.find(a=>a.id===currentAlbumId));
