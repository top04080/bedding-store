async function doMoveImages(targetAlbumId){
  if(targetAlbumId===currentAlbumId){closeMoveImgModal();return;}
  const srcAlbum=allAlbums.find(a=>a.id===currentAlbumId);
  const dstAlbum=allAlbums.find(a=>a.id===targetAlbumId);
  if(!srcAlbum||!dstAlbum)return;
  const toMove=srcAlbum.images.filter(i=>_moveImgIds.includes(i.id));
  srcAlbum.images=srcAlbum.images.filter(i=>!_moveImgIds.includes(i.id));
  srcAlbum.imageCount=srcAlbum.images.length;
  dstAlbum.images=[...dstAlbum.images,...toMove];
  dstAlbum.imageCount=dstAlbum.images.length;
  await saveToCloud();
  currentImages=srcAlbum.images;
  selectedIds.clear();
  applyImgSearch();
  updateSelection();
  renderAlbums(allAlbums);
  updatePanelInfo(srcAlbum);
  closeMoveImgModal();
